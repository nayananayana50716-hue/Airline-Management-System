{
  "name": "airport-app-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:backend": "npm --prefix airport-app-backend run dev",
    "dev:frontend": "npm --prefix airport-app run dev",
    "dev": "npx concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "start-dev-win": "powershell -ExecutionPolicy Bypass -File start-dev.ps1",
    "stop-dev-win": "powershell -ExecutionPolicy Bypass -File stop-dev.ps1"
    ,"start-dev-unix": "bash start-dev.sh",
    "stop-dev-unix": "bash stop-dev.sh"
  },
  "devDependencies": {
    "concurrently": "^8.0.1"
  }
}
